# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/devpulse

# Authentication Secrets
JWT_SECRET=devpulse_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# SMTP Alert Configuration (Optional for development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASS=testpassword
SMTP_FROM=DevPulse Alerts <alerts@devpulse.local>

# AI Post-Mortem Configuration (Supports 'groq' or 'gemini')
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_API_KEY=your_groq_or_openai_api_key_here
LLM_MODEL=openai/gpt-oss-120b

